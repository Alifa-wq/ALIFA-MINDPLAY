
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ALIFA MINDPLAY | Play Think Grow</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f5f3ff;
  color: #30294a;
}

header {
  background: linear-gradient(120deg, #6546a8, #8066c9);
  color: white;
  padding: 22px 18px;
  text-align: center;
}

.logo {
  width: 55px;
  height: 55px;
  background: white;
  color: #7654bd;
  border-radius: 18px;
  display: grid;
  place-items: center;
  font-size: 30px;
  font-weight: bold;
  margin: auto auto 10px;
}

header h1 {
  font-size: 25px;
  letter-spacing: 1px;
}

header p {
  font-size: 13px;
  margin-top: 7px;
  color: #eee8ff;
}

main {
  max-width: 650px;
  margin: auto;
  padding: 22px 17px 40px;
}

.hero {
  background: white;
  padding: 28px 20px;
  border-radius: 22px;
  text-align: center;
  box-shadow: 0 5px 20px #30294a12;
  margin-bottom: 25px;
}

.hero h2 {
  color: #6749a9;
  font-size: 24px;
  margin-bottom: 12px;
}

.hero p {
  color: #77718a;
  font-size: 14px;
  line-height: 1.7;
}

button {
  border: none;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
  border-radius: 12px;
  padding: 13px 20px;
  transition: 0.2s;
}

button:active {
  transform: scale(0.97);
}

.primary {
  background: #7555bb;
  color: white;
  margin-top: 18px;
}

.primary:hover {
  background: #5c409b;
}

.section-title {
  font-size: 19px;
  margin-bottom: 15px;
  color: #48366f;
}

.games {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13px;
}

.game-card {
  background: white;
  border-radius: 18px;
  padding: 20px 14px;
  text-align: center;
  border: 1px solid #eee9fa;
  box-shadow: 0 4px 13px #30294a0b;
  cursor: pointer;
  transition: 0.2s;
}

.game-card:hover {
  transform: translateY(-4px);
}

.game-icon {
  font-size: 34px;
  margin-bottom: 10px;
}

.game-card h3 {
  font-size: 15px;
  color: #60469c;
  margin-bottom: 7px;
}

.game-card p {
  color: #898398;
  font-size: 12px;
  line-height: 1.5;
}

#game-screen {
  display: none;
}

.game-box {
  background: white;
  border-radius: 20px;
  padding: 23px 18px;
  box-shadow: 0 5px 20px #30294a12;
  text-align: center;
}

.game-box h2 {
  color: #694ba9;
  margin-bottom: 12px;
}

.info {
  display: flex;
  justify-content: space-between;
  background: #f3effc;
  padding: 12px;
  border-radius: 12px;
  font-size: 13px;
  margin: 18px 0;
}

.question {
  font-size: 19px;
  font-weight: bold;
  line-height: 1.6;
  margin: 22px 0;
}

.answers {
  display: grid;
  gap: 10px;
}

.answer {
  background: #f1edfa;
  color: #51416f;
  border: 1px solid #e4dcf5;
  width: 100%;
}

.answer:hover {
  background: #e3d9f8;
}

.answer:disabled {
  cursor: default;
  opacity: 1;
}

.feedback {
  min-height: 25px;
  font-size: 14px;
  font-weight: bold;
  margin-top: 17px;
}

.back {
  background: #e9e2f7;
  color: #60469c;
  margin-top: 17px;
}

.result {
  background: #f3effc;
  border-radius: 15px;
  padding: 20px;
  margin-top: 18px;
}

.result h3 {
  color: #6848a8;
  margin-bottom: 10px;
}

footer {
  text-align: center;
  color: #9991a9;
  font-size: 12px;
  padding: 20px;
}

.hidden {
  display: none !important;
}

@media (max-width: 360px) {
  .games {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">A</div>
  <h1>ALIFA MINDPLAY</h1>
  <p>PLAY • THINK • GROW</p>
</header>

<main>

  <!-- HALAMAN DEPAN -->
  <section id="home-screen">

    <div class="hero">
      <h2>Welcome to MindPlay! ✨</h2>
      <p>
        Tempat bermain, berpikir, dan mengasah kemampuan.
        Tantang dirimu melalui permainan sederhana
        yang menyenangkan!
      </p>
      <button class="primary" onclick="showGames()">
        Mulai Bermain →
      </button>
    </div>

    <h2 class="section-title">🎮 Pilih Permainanmu</h2>

    <div class="games">

      <div class="game-card" onclick="startGame('logic')">
        <div class="game-icon">🧩</div>
        <h3>Tebak Pola</h3>
        <p>Uji kemampuan logika dan mengenali pola.</p>
      </div>

      <div class="game-card" onclick="startGame('math')">
        <div class="game-icon">🔢</div>
        <h3>Hitung Cepat</h3>
        <p>Latih ketelitian dan kemampuan berhitung.</p>
      </div>

      <div class="game-card" onclick="startGame('knowledge')">
        <div class="game-icon">💡</div>
        <h3>Asah Wawasan</h3>
        <p>Jawab pertanyaan dan tambah pengetahuan.</p>
      </div>

      <div class="game-card" onclick="startGame('memory')">
        <div class="game-icon">🧠</div>
        <h3>Asah Ingatan</h3>
        <p>Uji kemampuan mengingat urutan angka.</p>
      </div>

    </div>
  </section>

  <!-- HALAMAN PERMAINAN -->
  <section id="game-screen">

    <div class="game-box">
      <h2 id="game-title">Permainan</h2>

      <div class="info">
        <span id="progress">Soal 1</span>
        <span>⭐ Skor: <b id="score">0</b></span>
      </div>

      <div id="play-area">
        <div class="question" id="question"></div>
        <div class="answers" id="answers"></div>
        <div class="feedback" id="feedback"></div>
      </div>

      <div id="result-area" class="hidden">
        <div class="result">
          <h3>🎉 Permainan Selesai!</h3>
          <p id="final-score"></p>
          <p id="final-message" style="margin-top:10px"></p>
        </div>

        <button class="primary" onclick="restartGame()">
          Main Lagi ↻
        </button>
      </div>

      <button class="back" onclick="backToMenu()">
        ← Kembali ke Menu
      </button>
    </div>

  </section>

</main>

<footer>
  © 2026 ALIFA MINDPLAY · Play • Think • Grow
</footer>

<script>

const games = {

  logic: {
    title: "🧩 Tebak Pola",
    questions: [
      {
        q: "2, 4, 6, 8, ... Angka selanjutnya?",
        a: ["9", "10", "12", "14"],
        c: 1
      },
      {
        q: "1, 3, 6, 10, ... Angka selanjutnya?",
        a: ["12", "13", "15", "16"],
        c: 2
      },
      {
        q: "5, 10, 15, 20, ... Angka selanjutnya?",
        a: ["22", "24", "25", "30"],
        c: 2
      },
      {
        q: "1, 2, 4, 8, ... Angka selanjutnya?",
        a: ["10", "12", "14", "16"],
        c: 3
      },
      {
        q: "100, 90, 80, 70, ... Angka selanjutnya?",
        a: ["50", "55", "60", "65"],
        c: 2
      }
    ]
  },

  math: {
    title: "🔢 Hitung Cepat",
    questions: [
      {
        q: "15 + 25 = ?",
        a: ["30", "35", "40", "45"],
        c: 2
      },
      {
        q: "9 × 7 = ?",
        a: ["56", "63", "72", "69"],
        c: 1
      },
      {
        q: "100 - 45 = ?",
        a: ["45", "50", "55", "65"],
        c: 2
      },
      {
        q: "12 × 5 = ?",
        a: ["50", "55", "60", "65"],
        c: 2
      },
      {
        q: "144 ÷ 12 = ?",
        a: ["10", "11", "12", "14"],
        c: 2
      }
    ]
  },

  knowledge: {
    title: "💡 Asah Wawasan",
    questions: [
      {
        q: "Planet terbesar dalam tata surya adalah?",
        a: ["Bumi", "Mars", "Jupiter", "Venus"],
        c: 2
      },
      {
        q: "Hewan yang dikenal sebagai raja hutan adalah?",
        a: ["Harimau", "Singa", "Gajah", "Beruang"],
        c: 1
      },
      {
        q: "Berapa jumlah hari dalam satu minggu?",
        a: ["5", "6", "7", "8"],
        c: 2
      },
      {
        q: "Alat untuk mengukur suhu adalah?",
        a: ["Penggaris", "Termometer", "Kompas", "Jam"],
        c: 1
      },
      {
        q: "Warna hasil campuran biru dan kuning adalah?",
        a: ["Ungu", "Hijau", "Merah", "Oranye"],
        c: 1
      }
    ]
  },

  memory: {
    title: "🧠 Asah Ingatan",
    questions: [
      {
        q: "Ingat urutan ini: 3 - 7 - 2. Pilih urutan yang benar!",
        a: ["3 - 2 - 7", "7 - 3 - 2", "3 - 7 - 2", "2 - 7 - 3"],
        c: 2
      },
      {
        q: "Ingat urutan ini: 5 - 1 - 8. Pilih urutan yang benar!",
        a: ["5 - 1 - 8", "1 - 5 - 8", "8 - 1 - 5", "5 - 8 - 1"],
        c: 0
      },
      {
        q: "Ingat urutan ini: 9 - 4 - 6. Pilih urutan yang benar!",
        a: ["4 - 9 - 6", "9 - 4 - 6", "6 - 4 - 9", "9 - 6 - 4"],
        c: 1
      },
      {
        q: "Ingat urutan ini: 2 - 8 - 5. Pilih urutan yang benar!",
        a: ["8 - 2 - 5", "5 - 8 - 2", "2 - 8 - 5", "2 - 5 - 8"],
        c: 2
      },
      {
        q: "Ingat urutan ini: 7 - 3 - 1. Pilih urutan yang benar!",
        a: ["7 - 3 - 1", "3 - 7 - 1", "1 - 3 - 7", "7 - 1 - 3"],
        c: 0
      }
    ]
  }

};

let currentGame = "";
let currentQuestion = 0;
let score = 0;
let answered = false;

function showGames() {
  document.getElementById("home-screen").style.display = "block";
  document.getElementById("home-screen").scrollIntoView();
}

function startGame(type) {
  currentGame = type;
  currentQuestion = 0;
  score = 0;

  document.getElementById("home-screen").style.display = "none";
  document.getElementById("game-screen").style.display = "block";
  document.getElementById("game-title").textContent = games[type].title;
  document.getElementById("result-area").classList.add("hidden");
  document.getElementById("play-area").classList.remove("hidden");

  showQuestion();
  window.scrollTo(0, 0);
}

function showQuestion() {
  answered = false;

  const data = games[currentGame].questions[currentQuestion];

  document.getElementById("progress").textContent =
    "Soal " + (currentQuestion + 1) + " / 5";

  document.getElementById("score").textContent = score;

  document.getElementById("question").textContent = data.q;

  document.getElementById("feedback").textContent = "";

  const answers = document.getElementById("answers");
  answers.innerHTML = "";

  data.a.forEach((answer, index) => {
    const button = document.createElement("button");

    button.className = "answer";
    button.textContent = answer;

    button.onclick = () => checkAnswer(index);

    answers.appendChild(button);
  });
}

function checkAnswer(index) {
  if (answered) return;

  answered = true;

  const data = games[currentGame].questions[currentQuestion];
  const buttons = document.querySelectorAll(".answer");
  const feedback = document.getElementById("feedback");

  buttons.forEach((button, i) => {
    button.disabled = true;

    if (i === data.c) {
      button.style.background = "#d8f5e5";
      button.style.borderColor = "#76bd91";
    }

    if (i === index && index !== data.c) {
      button.style.background = "#ffe0e0";
      button.style.borderColor = "#e99a9a";
    }
  });

  if (index === data.c) {
    score += 20;
    feedback.textContent = "Benar! Hebat sekali! 🎉";
    feedback.style.color = "#26834d";
  } else {
    feedback.textContent = "Belum tepat. Tetap semangat! 💪";
    feedback.style.color = "#c45a5a";
  }

  document.getElementById("score").textContent = score;

  const next = document.createElement("button");
  next.className = "primary";
  next.textContent = currentQuestion === 4 ? "Lihat Hasil" : "Soal Berikutnya →";
  next.onclick = nextQuestion;

  document.getElementById("answers").appendChild(next);
}

function nextQuestion() {
  currentQuestion++;

  if (currentQuestion < 5) {
    showQuestion();
  } else {
    showResult();
  }
}

function showResult() {
  document.getElementById("play-area").classList.add("hidden");
  document.getElementById("result-area").classList.remove("hidden");

  document.getElementById("final-score").textContent =
    "Skor kamu: " + score + " / 100";

  let message = "";

  if (score === 100) {
    message = "Sempurna! Kamu berhasil menjawab semuanya! 🏆";
  } else if (score >= 60) {
    message = "Bagus! Kemampuanmu semakin berkembang! 🌟";
  } else {
    message = "Terus berlatih ya! Setiap percobaan adalah kemajuan. 💜";
  }

  document.getElementById("final-message").textContent = message;
}

function restartGame() {
  startGame(currentGame);
}

function backToMenu() {
  document.getElementById("game-screen").style.display = "none";
  document.getElementById("home-screen").style.display = "block";
  window.scrollTo(0, 0);
}

</script>

</body>
</html>
