<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#10172b">
<title>ALIFA — Game Latihan Berpikir</title>
<style>
:root{--bg:#0b1020;--panel:#151d34;--panel2:#1c2742;--ink:#f3f6ff;--muted:#aab6d2;--a:#a78bfa;--b:#55d6be;--gold:#ffd166;--line:#2b3858}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 15% 0%,#24234d 0,transparent 40%),radial-gradient(ellipse at 90% 10%,#123c4b 0,transparent 35%),var(--bg);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);min-height:100vh}
.wrap{max-width:1100px;margin:auto;padding:22px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.brand{display:flex;gap:12px;align-items:center}
.logo{width:52px;height:52px;border-radius:17px;background:linear-gradient(135deg,var(--a),var(--b));display:grid;place-items:center;color:#10172b;font-size:25px;font-weight:900;box-shadow:0 8px 30px #7c3aed55}
.brand h1{font-size:20px;letter-spacing:2px;margin:0}
.brand small{color:var(--muted);letter-spacing:1px}
.chip{border:1px solid var(--line);background:#111a30;padding:9px 14px;border-radius:30px;color:var(--muted);font-size:13px}
.hero{padding:34px 0 24px;display:grid;grid-template-columns:1.3fr .7fr;gap:20px;align-items:center}
.hero h2{font-size:clamp(30px,5vw,52px);line-height:1.07;margin:8px 0 12px;letter-spacing:-1.5px}
.hero h2 span{background:linear-gradient(90deg,var(--a),var(--b));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--muted);line-height:1.7;max-width:650px}
.hero-art{border:1px solid #364365;border-radius:28px;min-height:210px;background:linear-gradient(145deg,#24264b,#143947);display:grid;place-items:center;font-size:75px;position:relative;overflow:hidden}
.hero-art:after{content:"";position:absolute;width:210px;height:210px;border:1px solid #ffffff18;border-radius:50%;right:-35px;bottom:-90px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:8px 0 22px}
.stat,.panel{background:linear-gradient(160deg,#18223a,#121a2d);border:1px solid var(--line);border-radius:20px;padding:18px}
.stat strong{display:block;font-size:25px;color:var(--b)}
.stat span{font-size:12px;color:var(--muted)}
.layout{display:grid;grid-template-columns:300px 1fr;gap:18px}
.panel h3{margin:0 0 14px;font-size:16px}
.categories{display:grid;gap:8px}
.cat{width:100%;border:1px solid var(--line);background:#111a2e;color:var(--ink);padding:12px;border-radius:13px;text-align:left;cursor:pointer;display:flex;align-items:center;gap:10px}
.cat.active{border-color:var(--a);background:#2a2450}
.cat .ico{font-size:20px}
.cat small{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.btn{border:0;border-radius:13px;padding:12px 16px;font-weight:750;cursor:pointer;background:linear-gradient(90deg,var(--a),var(--b));color:#0b1020}
.btn.secondary{background:#24314e;color:var(--ink);border:1px solid var(--line)}
.btn.gold{background:var(--gold);color:#211a06}
.btn:disabled{opacity:.45;cursor:not-allowed}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}
.game{min-height:420px}
.game-top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.tag{font-size:12px;color:var(--b);background:#153b3a;border-radius:30px;padding:7px 11px}
.progress{height:6px;background:#29344f;border-radius:8px;margin:18px 0;overflow:hidden}
.progress div{height:100%;background:linear-gradient(90deg,var(--a),var(--b));width:0;transition:width .3s}
.qnum{color:var(--muted);font-size:12px}
.question{font-size:clamp(20px,3vw,27px);font-weight:750;line-height:1.4;margin:18px 0}
.visual{border:1px dashed #536285;background:#10182b;border-radius:16px;padding:18px;margin:14px 0;color:#dce5ff;white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.5}
.answer{width:100%;min-height:115px;resize:vertical;background:#0d1426;color:var(--ink);border:1px solid #344362;border-radius:14px;padding:14px;font:inherit;outline:none}
.answer:focus{border-color:var(--a)}
.hint{display:none;margin-top:12px;padding:14px;border-radius:13px;background:#302a1c;border:1px solid #66542a;color:#ffe5a0;line-height:1.5}
.hint.show{display:block}
.notice{color:var(--muted);font-size:12px;line-height:1.5;margin-top:12px}
.result{margin-top:14px;padding:14px;border:1px solid #355d55;background:#132b2b;border-radius:14px;display:none;line-height:1.6}
.result.show{display:block}
.bottom{margin:22px 0;text-align:center;color:#7f8baa;font-size:12px}
@media(max-width:760px){.hero{grid-template-columns:1fr}.hero-art{min-height:130px;font-size:55px}.layout{grid-template-columns:1fr}.stats{gap:8px}.stat{padding:13px}.wrap{padding:14px}}
</style>
</head>
<body>
<div class="wrap">
<header>
<div class="brand">
<div class="logo">A</div>
<div><h1>ALIFA</h1><small>GAME LATIHAN BERPIKIR</small></div>
</div>
<div class="chip">✦ Belajar • Tantang • Tumbuh</div>
</header>

<section class="hero">
<div>
<div class="tag">YOUR BRAIN'S PLAYGROUND</div>
<h2>Asah pikiran.<br><span>Naik level.</span></h2>
<p>Petualangan belajar campuran dari pengetahuan SD, SMP, SMK sampai kuliah. Jelaskan dengan bahasamu sendiri, pecahkan kasus, dan latih logika satu tantangan setiap kali.</p>
</div>
<div class="hero-art" aria-label="Ilustrasi buku dan ide">🧠📚✨</div>
</section>

<div class="stats">
<div class="stat"><strong id="played">0</strong><span>TANTANGAN DICOBA</span></div>
<div class="stat"><strong id="saved">0</strong><span>JAWABAN DISIMPAN</span></div>
<div class="stat"><strong id="level">Pemula</strong><span>LEVEL LATIHAN</span></div>
</div>

<div class="layout">
<aside class="panel">
<h3>🎯 Pilih dunia belajar</h3>
<div class="categories" id="categories"></div>
<div class="actions">
<button class="btn" id="random">🎲 Topik random</button>
<button class="btn secondary" id="reset">↻ Reset sesi</button>
</div>
<p class="notice">Petunjuk hanya muncul saat kamu menekan tombolnya. Penilaian tidak otomatis—gunakan tombol “UDAH, NILAI!” saat kamu memang siap.</p>
</aside>

<main class="panel game">
<div class="game-top">
<span class="tag" id="topic">TOPIK • RANDOM</span>
<span class="qnum" id="qnum">Tantangan 1</span>
</div>
<div class="progress"><div id="bar"></div></div>
<div class="question" id="question"></div>
<div class="visual" id="visual"></div>
<textarea class="answer" id="answer" placeholder="Tulis jawaban atau penjelasanmu di sini..."></textarea>
<div class="actions">
<button class="btn secondary" id="hintBtn">💡 Petunjuk</button>
<button class="btn secondary" id="saveBtn">📌 Simpan jawaban</button>
<button class="btn" id="nextBtn">Tantangan berikutnya →</button>
<button class="btn gold" id="gradeBtn">UDAH, NILAI!</button>
</div>
<div class="hint" id="hint"></div>
<div class="result" id="result"></div>
<p class="notice">Mode latihan: simpan jawabanmu dulu. Kamu bebas mengerjakan dengan kalimat sendiri. Evaluasi menggunakan rubrik ketat hanya setelah kamu menekan “UDAH, NILAI!”.</p>
</main>
</div>

<div class="bottom">ALIFA • Learning is a journey, not a race. ✦</div>
</div>

<script>
const packs=[
{name:"Pengetahuan umum",icon:"🌍",desc:"SD–SMP • fakta & pemahaman",items:[
{q:"Mengapa kita mengalami siang dan malam di Bumi?",v:"☀️ Matahari →→→ 🌍\n        ↻ (Bumi berputar)",h:"Perhatikan gerakan Bumi pada porosnya. Bukan Matahari yang mengelilingi Bumi setiap hari.",key:["rotasi","berputar","poros","matahari"]},
{q:"Sebutkan dua perbedaan antara cuaca dan iklim.",v:"Cuaca: kondisi atmosfer dalam waktu singkat\nIklim: pola kondisi dalam jangka panjang",h:"Bandingkan rentang waktu dan luas wilayah pengamatan.",key:["jangka","waktu","singkat","panjang"]},
{q:"Mengapa menjaga keberagaman budaya Indonesia penting?",v:"🧩 Banyak budaya → identitas bangsa",h:"Pikirkan identitas, saling menghargai, dan kekayaan tradisi.",key:["identitas","menghargai","budaya"]}
]},
{name:"Sejarah & geografi",icon:"🏛️",desc:"Timeline, wilayah & peradaban",items:[
{q:"Proklamasi Indonesia dibacakan pada tanggal berapa, dan apa makna utamanya?",v:"TIMELINE\n17 Agustus 1945 → Proklamasi Kemerdekaan",h:"Tanggalnya berada di bulan Agustus 1945. Makna utamanya berkaitan dengan pernyataan merdeka.",key:["17 agustus 1945","kemerdekaan"]},
{q:"Mengapa peradaban Khmer berkembang dekat Danau Tonlé Sap?",v:"🌊 Danau Tonlé Sap\n       ↓\nPertanian • air • pangan • transportasi",h:"Hubungkan danau dengan sumber air, perikanan, dan pertanian.",key:["air","pertanian","ikan","pangan"]},
{q:"Apa pengaruh letak Indonesia di antara dua benua dan dua samudra?",v:"ASIA  🌏  AUSTRALIA\nINDIA 🌊 PASIFIK",h:"Pikirkan jalur perdagangan, iklim, dan pertemuan budaya.",key:["perdagangan","budaya","strategis","iklim"]}
]},
{name:"Manajemen & bisnis",icon:"📊",desc:"SMK–Kuliah • kasus nyata",items:[
{q:"Toko menerima 100 pesanan baju, tetapi pemasok hanya mengirim 60. Apa langkah manajerial yang tepat?",v:"Pesanan: 100\nBarang datang: 60\nKekurangan: ?",h:"Hitung selisihnya, komunikasikan kepada pemasok, lalu beri informasi yang jujur kepada pelanggan dan tawarkan solusi.",key:["40","pemasok","pelanggan","komunikasi","solusi"]},
{q:"Pengunjung toko online 1.000 orang, yang membeli 80. Ada 20 keluhan ukuran dan 5 keluhan pengiriman terlambat. Masalah apa yang perlu diprioritaskan dan bagaimana?",v:"1.000 pengunjung → 80 pembeli\n20 keluhan ukuran • 5 keterlambatan",h:"Hitung conversion rate. Keluhan ukuran paling banyak; lihat panduan ukuran dan informasi produk, sambil tetap tindak lanjuti keterlambatan.",key:["8%","ukuran","panduan","konversi","pengiriman"]},
{q:"Kedai minuman menerima keluhan antrean lama saat jam ramai. Berikan strategi operasional dan alasan.",v:"Jam ramai → antrean panjang → pelanggan menunggu",h:"Pikirkan pembagian tugas, persiapan bahan, alur pesanan, dan evaluasi waktu tunggu.",key:["pembagian","persiapan","alur","waktu","pegawai"]},
{q:"Jelaskan perbedaan beban kerja dan work-life balance dalam konteks karyawan.",v:"Karyawan 👩‍💼 • tugas • waktu kerja • kehidupan pribadi",h:"Beban kerja terkait tuntutan/tugas; work-life balance terkait keseimbangan antara pekerjaan dan kehidupan pribadi.",key:["tugas","tuntutan","keseimbangan","pribadi"]}
]},
{name:"Administrasi & hukum",icon:"⚖️",desc:"SMK–Kuliah • dokumen & konsep",items:[
{q:"Apa fungsi utama notulen dalam sebuah rapat organisasi?",v:"RAPAT → catatan → keputusan & tindak lanjut",h:"Catatan ini membantu peserta mengingat pembahasan, keputusan, dan siapa melakukan apa.",key:["keputusan","pembahasan","tindak lanjut","catatan"]},
{q:"Mengapa perjanjian kerja perlu memuat hak dan kewajiban para pihak?",v:"Pihak pekerja ↔ pihak pemberi kerja",h:"Pikirkan kejelasan, kepastian, tanggung jawab, dan mengurangi perselisihan.",key:["hak","kewajiban","jelas","perselisihan"]},
{q:"Dalam administrasi, apa risiko jika dokumen penting tidak diberi nomor dan diarsipkan dengan baik?",v:"Dokumen → ??? → pencarian & pengendalian",h:"Bayangkan dokumen sulit ditemukan, terlacak, atau dibuktikan kembali.",key:["sulit","hilang","pencarian","arsip","bukti"]}
]},
{name:"Matematika & logika",icon:"🧮",desc:"Hitungan cepat & nalar",items:[
{q:"Modal satu produk Rp70.000, harga jual Rp100.000. Jika terjual 30 unit, berapa laba kotor total?",v:"Laba/unit = harga jual − modal\nLaba total = laba/unit × 30",h:"Cari laba per unit dahulu, kemudian kalikan jumlah unit terjual.",key:["90000","90.000","30.000","900000"]},
{q:"Sebuah barang seharga Rp200.000 mendapat diskon 15%. Berapa harga setelah diskon?",v:"Harga awal: Rp200.000\nDiskon: 15%",h:"Hitung 15% dari 200.000, lalu kurangkan dari harga awal.",key:["170000","170.000"]},
{q:"Ada 3 gelas: A air dingin, B suhu ruang, C air hangat. Ketiganya dimasukkan ke ruangan ber-es. Gelas mana yang awalnya memiliki selisih suhu terbesar terhadap es? Jelaskan.",v:"A 🧊 • B 🌡️ • C ♨️\nLingkungan: 🧊",h:"Bandingkan suhu awal masing-masing dengan suhu es. Suhu hangat umumnya memiliki selisih lebih besar.",key:["c","hangat","selisih","suhu"]}
]},
{name:"Bahasa & komunikasi",icon:"💬",desc:"Literasi, argumentasi & speaking",items:[
{q:"Buat satu pesan profesional kepada pelanggan untuk meminta maaf karena pesanan terlambat, sekaligus memberi solusi.",v:"Pelanggan menunggu pesanan 📦",h:"Pesan efektif: sapaan, permintaan maaf, penjelasan singkat, solusi konkret, dan penutup sopan.",key:["maaf","pesanan","solusi","terima kasih"]},
{q:"Apa perbedaan fakta dan opini? Berikan masing-masing satu contoh.",v:"Fakta = dapat diverifikasi\nOpini = pendapat/penilaian",h:"Fakta dapat dicek kebenarannya. Opini menunjukkan pandangan seseorang.",key:["verifikasi","pendapat","opini","contoh"]},
{q:"Jelaskan bagaimana slogan/tagline dapat membantu sebuah merek dikenal konsumen.",v:"MEREK → pesan ringkas → ingatan audiens",h:"Pikirkan pesan singkat, identitas, konsistensi, dan daya ingat.",key:["pesan","identitas","ingat","konsisten"]}
]}
];

let chosen=0,index=0,played=0,saved=0,answers={},graded=false;
const $=id=>document.getElementById(id);

function drawCats(){
$("categories").innerHTML=packs.map((p,i)=>`<button class="cat ${i===chosen?'active':''}" data-i="${i}"><span class="ico">${p.icon}</span><span><b>${p.name}</b><small>${p.desc}</small></span></button>`).join("");
document.querySelectorAll(".cat").forEach(b=>b.onclick=()=>{
chosen=+b.dataset.i;
index=0;
drawCats();
render()
})
}

function current(){return packs[chosen].items[index%packs[chosen].items.length]}

function render(){
let p=packs[chosen],q=current();
$("topic").textContent=p.icon+" "+p.name.toUpperCase();
$("qnum").textContent="Tantangan "+(index+1);
$("bar").style.width=((index%p.items.length+1)/p.items.length*100)+"%";
$("question").textContent=q.q;
$("visual").textContent=q.v;
$("answer").value=answers[chosen+"-"+index]||"";
$("hint").textContent="";
$("hint").classList.remove("show");
$("result").classList.remove("show");
graded=false;
$("gradeBtn").disabled=false
}

$("hintBtn").onclick=()=>{
$("hint").textContent="💡 Petunjuk: "+current().h;
$("hint").classList.add("show")
};

$("saveBtn").onclick=()=>{
answers[chosen+"-"+index]=$("answer").value.trim();
if(!answers[chosen+"-"+index]){
$("result").textContent="Tulis jawaban dulu sebelum disimpan ya.";
$("result").classList.add("show");
return
}
saved=Object.keys(answers).filter(k=>answers[k]).length;
$("saved").textContent=saved;
$("result").textContent="Jawaban tersimpan di sesi ini. Belum dinilai—kamu yang menentukan kapan siap!";
$("result").classList.add("show")
};

$("nextBtn").onclick=()=>{
answers[chosen+"-"+index]=$("answer").value.trim();
index++;
played++;
$("played").textContent=played;
$("level").textContent=played<4?"Pemula":played<10?"Penjelajah":"Pemikir";
render()
};

$("random").onclick=()=>{
chosen=Math.floor(Math.random()*packs.length);
index=Math.floor(Math.random()*packs[chosen].items.length);
drawCats();
render()
};

$("reset").onclick=()=>{
if(confirm("Reset jawaban dan statistik sesi ini?")){
index=0;
played=0;
saved=0;
answers={};
$("played").textContent=0;
$("saved").textContent=0;
$("level").textContent="Pemula";
render()
}
};

$("gradeBtn").onclick=()=>{
const a=$("answer").value.trim().toLowerCase();
if(!a){
$("result").textContent="Isi jawabanmu dulu, lalu tekan UDAH, NILAI!";
$("result").classList.add("show");
return
}
const keys=current().key;
let matched=keys.filter(k=>a.includes(k.toLowerCase())).length;
let pct=Math.round(matched/keys.length*100);
let msg=pct>=50?"Ada beberapa konsep penting yang sudah kamu sebut.":"Jawaban masih perlu diperdalam.";
$("result").innerHTML=`<b>Evaluasi awal berbasis kata kunci: ${pct}%</b><br>${msg}<br><small>Ini pemeriksaan otomatis sederhana, bukan penilaian penuh. Periksa apakah penjelasanmu masuk akal, lengkap, dan tepat konsep.</small>`;
$("result").classList.add("show");
graded=true;
$("gradeBtn").disabled=true
};

drawCats();
render();
</script>
</body>
</html>
